# 复制为 .env 后可改；不创建 .env 也能跑，全部走默认值
# 1 = 全链路 mock，不需要 Ollama / ONNX / Chroma / TTS 就能验收
BRAIN_MOCK=1

BRAIN_HOST=0.0.0.0
BRAIN_PORT=8000
CONSOLE_HOST=0.0.0.0
CONSOLE_PORT=8001

# 真实模型接入（阶段 0 实测通过后再打开）
OLLAMA_BASE=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
EMBED_MODEL=bge-m3
TTS_BASE=http://127.0.0.1:9880
TTS_TIMEOUT=30
JUDGE_MODEL_PATH=models/sentiment_8class.onnx
JUDGE_CONTEXT_TURNS=2

# 控制平面写操作口令，留空则本地放行
ADMIN_TOKEN=
